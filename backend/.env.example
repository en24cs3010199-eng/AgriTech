# AgriTech Backend Environment Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
# You can use your MongoDB Atlas URI:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/agritech?retryWrites=true&w=majority
# Or local MongoDB:
# MONGODB_URI=mongodb://localhost:27017/agritech
# In production (NODE_ENV=production), MONGODB_URI is mandatory — the server will not start without it, and Atlas auth failures are fatal (no in-memory fallback).
# In development/test, omitting MONGODB_URI starts an in-memory MongoDB engine for local/zero-config testing only.
# IMPORTANT: Special characters in the Atlas password (e.g. @, #, %) must be percent-encoded. E.g. @ → %40, # → %23.
MONGODB_URI=

# JWT Authentication Secret & Expiration
JWT_SECRET=agritech_jwt_super_secure_secret_key_2026_skillwallet
JWT_EXPIRES_IN=7d

# Optional External API Keys (Leave empty to use free built-in Open-Meteo & Grounded Knowledge Base)
OPENWEATHER_API_KEY=
GEMINI_API_KEY=

# Client Application URL for CORS
CLIENT_URL=http://localhost:3000
